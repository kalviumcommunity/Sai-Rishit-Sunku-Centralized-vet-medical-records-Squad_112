rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions mirroring Firestore security logic
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isVet() {
      return isAuthenticated() && (
        (request.auth.token.role != null && request.auth.token.role == 'vet') ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && getUserData().role == 'vet')
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.role != null && request.auth.token.role == 'admin') ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
      );
    }

    function isPetOwner(petId) {
      return isAuthenticated() && (
        firestore.exists(/databases/(default)/documents/pets/$(petId)) &&
        firestore.get(/databases/(default)/documents/pets/$(petId)).data.ownerId == request.auth.uid
      );
    }

    // ========================================================================
    // MEDICAL DOCUMENTS STORAGE (DAY 13)
    // ========================================================================
    // Path: pets/{petId}/documents/{fileName}
    //
    // ACCESS CONTROL VS E2EE NOTE:
    // These Storage rules enforce strict cloud-side Access Control Lists (ACLs).
    // Files are protected in transit (TLS) and encrypted at rest by Google Cloud.
    // However, they are NOT "End-to-End Encrypted" (E2EE) with client-managed keys,
    // because authorized veterinarians across branches must be able to read and render
    // radiograph X-rays, blood panels, and PDF reports directly.
    // ========================================================================
    match /pets/{petId}/documents/{fileName} {
      // Read: Any verified veterinarian across branches, admin, or the registered pet owner
      allow read: if isAuthenticated() && (
        isVet() || isAdmin() || isPetOwner(petId)
      );

      // Create / Write: Attending vet, pet owner, or admin (Max 25MB file size)
      allow write: if isAuthenticated() && (
        isVet() || isAdmin() || isPetOwner(petId)
      ) && request.resource.size <= 25 * 1024 * 1024;

      // Delete: Pet owner, vet, or admin
      allow delete: if isAuthenticated() && (
        isVet() || isAdmin() || isPetOwner(petId)
      );
    }
  }
}

