rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================================
    // VETCARE SECURE BASELINE (DAY 1)
    // ============================================================================
    // Baseline security posture: Default Deny All.
    // Scoped rules for each collection (users, pets, treatments, vaccinations,
    // branches, medical_documents) will be layered in progressively.
    // ============================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
