rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // HELPER FUNCTIONS
    // ============================================================================
    
    // Checks if the incoming request is authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifies the authenticated user's UID matches the target document ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ============================================================================
    // ROLE-BASED HELPERS
    // ============================================================================
    
    // Retrieves profile data for the authenticated user from the users collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Checks if the user document exists in the users collection
    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Checks if user is explicitly registered with 'owner' role in the database
    function isOwnerRole() {
      return hasUserDoc() && getUserData().role == 'owner';
    }

    // Checks if user has veterinary privileges (via token claim or users document)
    function isVet() {
      return isAuthenticated() && (
        (request.auth.token.role != null && request.auth.token.role == 'vet') ||
        (hasUserDoc() && getUserData().role == 'vet')
      );
    }

    // Checks if user has administrative privileges (via token claim or users document)
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.role != null && request.auth.token.role == 'admin') ||
        (hasUserDoc() && getUserData().role == 'admin')
      );
    }

    // Checks if a target pet document exists in the pets collection
    function petExists(petId) {
      return exists(/databases/$(database)/documents/pets/$(petId));
    }

    // Verifies whether the requesting authenticated user owns the referenced pet
    function isPetOwner(petId) {
      return petExists(petId) && get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid;
    }

    // ============================================================================
    // USERS COLLECTION (DAY 2)
    // ============================================================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['name', 'email', 'role', 'createdAt'])
        && request.resource.data.role in ['owner', 'vet', 'admin']
        && request.resource.data.name is string
        && request.resource.data.email is string;
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // ============================================================================
    // PETS COLLECTION (DAY 3 - TIGHTENED)
    // ============================================================================
    // - Explicit role enforcement from users collection: requires verified 'owner', 'vet', or 'admin' role.
    // - Non-owner, non-vet, non-admin sessions are strictly DENIED.
    // - Missing ownerId on write is strictly REJECTED.
    // - Microchip ID is WRITE-ONCE: immutable after creation.
    // ============================================================================
    match /pets/{petId} {
      // Read: Verified Owner can read only their own pets; Vets and Admins have global cross-branch read.
      allow read: if isAuthenticated() && (
        (resource.data.ownerId == request.auth.uid && isOwnerRole()) ||
        isVet() ||
        isAdmin()
      );

      // Create: Only verified owners (ownerId == auth.uid) or Admins can register pets.
      allow create: if isAuthenticated() && (
        (isOwnerRole() && request.resource.data.ownerId == request.auth.uid) || isAdmin()
      )
      && request.resource.data.keys().hasAll(['name', 'species', 'breed', 'gender', 'dateOfBirth', 'microchipId', 'ownerId', 'createdAt'])
      && request.resource.data.name is string
      && request.resource.data.species is string
      && request.resource.data.microchipId is string
      && request.resource.data.microchipId.size() > 0;

      // Update: Only the verified owner or Admin can update core demographic info.
      // WRITE-ONCE: microchipId & ownerId are immutable after creation.
      allow update: if isAuthenticated() && (
        (resource.data.ownerId == request.auth.uid && isOwnerRole()) || isAdmin()
      )
      && request.resource.data.microchipId == resource.data.microchipId
      && request.resource.data.ownerId == resource.data.ownerId;

      // Delete: Only verified owner or Admin can delete a pet record.
      allow delete: if isAuthenticated() && (
        (resource.data.ownerId == request.auth.uid && isOwnerRole()) || isAdmin()
      );
    }

    // ============================================================================
    // TREATMENTS COLLECTION (DAY 4 / 5)
    // ============================================================================
    // - Cross-branch access: any vet can read all treatments.
    // - Owners can read treatments for their own pets.
    // - Creation: ONLY by authenticated vets, for existing pets only.
    // - Anti-Spoofing: vetId must match auth.uid and branchId must match vet's assigned branch.
    // - Server Timestamp: createdAt must be request.time (not client-supplied).
    // - Edit/Delete: Only creating vet or admin can modify/remove.
    // ============================================================================
    match /treatments/{treatmentId} {
      // Read: Any vet across network, admin, or the pet's owner.
      allow read: if isVet() || isAdmin() || isPetOwner(resource.data.petId);

      // Create: Only authenticated vets, strictly validated.
      allow create: if isVet()
        && petExists(request.resource.data.petId)
        && request.resource.data.keys().hasAll([
          'petId', 'diagnosis', 'medication', 'notes', 'treatmentDate',
          'status', 'vetId', 'branchId', 'createdAt'
        ])
        && request.resource.data.status in ['active', 'resolved']
        && request.resource.data.vetId == request.auth.uid
        && request.resource.data.branchId == getUserData().branchId
        && request.resource.data.createdAt == request.time;

      // Update: STRICT POLICY - A colleague vet at the same branch CANNOT edit another vet's record.
      // Only the exact original creator (vetId == auth.uid) or a Network Admin can edit.
      // Immutable fields: petId, vetId, branchId, and createdAt cannot be changed.
      allow update: if ((isVet() && resource.data.vetId == request.auth.uid) || isAdmin())
        && request.resource.data.status in ['active', 'resolved']
        && request.resource.data.petId == resource.data.petId
        && request.resource.data.vetId == resource.data.vetId
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.createdAt == resource.data.createdAt;

      // Delete: Only original creating vet or admin. Colleague vets at the same branch are DENIED.
      allow delete: if (isVet() && resource.data.vetId == request.auth.uid) || isAdmin();
    }

    // ============================================================================
    // VACCINATIONS COLLECTION (DAY 6)
    // ============================================================================
    // - Cross-branch access: any vet can read all vaccination history.
    // - Owners can read vaccinations for their own pets.
    // - Creation: ONLY by authenticated vets, for existing pets only.
    // - Anti-Spoofing: vetId and branchId must match authenticated vet's profile.
    // - Server Timestamp: createdAt must be request.time.
    // - Edit/Delete: Strict Creator-Only Policy - colleague vets at the same branch CANNOT edit/delete.
    // ============================================================================
    match /vaccinations/{vaccinationId} {
      // Read: Any vet, admin, or the pet's owner.
      allow read: if isVet() || isAdmin() || isPetOwner(resource.data.petId);

      // Create: Only authenticated vets, strictly validated.
      allow create: if isVet()
        && petExists(request.resource.data.petId)
        && request.resource.data.keys().hasAll([
          'petId', 'vaccineName', 'dateGiven', 'nextDueDate',
          'vetId', 'branchId', 'notes', 'createdAt'
        ])
        && request.resource.data.vetId == request.auth.uid
        && request.resource.data.branchId == getUserData().branchId
        && request.resource.data.createdAt == request.time;

      // Update: STRICT POLICY - Colleague vets at the same branch CANNOT edit another vet's vaccination.
      // Only the exact administering vet (vetId == auth.uid) or an admin can edit.
      // Immutable fields: petId, vetId, branchId, and createdAt cannot be tampered with.
      allow update: if ((isVet() && resource.data.vetId == request.auth.uid) || isAdmin())
        && request.resource.data.petId == resource.data.petId
        && request.resource.data.vetId == resource.data.vetId
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.createdAt == resource.data.createdAt;

      // Delete: Only administering vet or admin. Colleague vets at the same branch are DENIED.
      allow delete: if (isVet() && resource.data.vetId == request.auth.uid) || isAdmin();
    }

    // ============================================================================
    // BRANCHES COLLECTION
    // ============================================================================
    // - Authenticated users (owners, vets, admins) can read clinic branch directory.
    // - Creation, update, and deletion restricted to network administrators.
    // ============================================================================
    match /branches/{branchId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================================
    // MEDICAL_DOCUMENTS COLLECTION (DAY 12)
    // ============================================================================
    // - Read: Any authenticated user (cross-branch access for vets and owners)
    // - Create: Authenticated users (vets or owners) attaching petId, fileName, fileUrl
    // - Delete: Creating user or admin
    // ============================================================================
    match /medical_documents/{documentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.petId is string
        && request.resource.data.fileName is string
        && request.resource.data.fileUrl is string
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if (isAuthenticated() && resource.data.uploadedBy == request.auth.uid) || isAdmin();
    }

    // ============================================================================
    // DEFAULT DENY ALL (PROGRESSIVE SCOPING)
    // ============================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

